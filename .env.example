# Copy to .env (never commit .env). Only public, non-secret values belong in the app.
# Secrets for the Worker are set with `wrangler secret put`, never in a file.

# Stellar network. Sprint 1 supports testnet only.
STELLAR_NETWORK=testnet

# Cosignly API base URL (used from Week 3).
EXPO_PUBLIC_API_URL=https://cosignly-api.murat-yayla-26.workers.dev
